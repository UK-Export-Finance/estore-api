{
  "name": "estore-api",
  "version": "1.9.0",
  "private": true,
  "description": "eStore API",
  "license": "MIT",
  "author": "UKEF",
  "workspaces": [
    "eslint-local-rules"
  ],
  "scripts": {
    "api-test": "jest --coverage --selectProjects=API --passWithNoTests",
    "audit:fix": "npm audit --fix",
    "build": "nest build -p tsconfig.build.json",
    "housekeeping": "npm update --save --legacy-peer-deps && npm i --legacy-peer-deps && npm run type-check && npm run prettier:fix && npm run lint:fix && npm run validate:yml && npm run audit:fix && npm run spellcheck",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --no-error-on-unmatched-pattern --check **/*.{ts,js}",
    "prettier:fix": "prettier --write **/*.{ts,js}",
    "snapshot:update": "npm run unit-test -- -u && npm run api-test -- -u",
    "spellcheck": "cspell lint --gitignore --no-must-find-files --unique --no-progress --show-suggestions --color '**/*'",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --tsc --watch",
    "start:prod": "node dist/src/main",
    "type-check": "tsc --noEmit --pretty",
    "unit-test": "jest --selectProjects=Unit",
    "unit-test-dev": "jest --verbose --config=jest.config.ts",
    "validate:all": "npm run lint:fix && npm run prettier:fix && npm run type-check && npm run validate:yml && npm run validate:md",
    "validate:md": "npx markdownlint-cli --config .markdownlint.json \"**/*.md\"",
    "validate:yml": "npx yaml-lint **/*.yml --ignore=**/node_modules"
  },
  "lint-staged": {
    "**/package.json": "sort-package-json",
    "**/*.{js,ts}": [
      "npm run lint:fix",
      "npm run prettier:fix"
    ],
    "**/*.md": [
      "prettier --write",
      "npx markdownlint-cli --config .markdownlint.json"
    ],
    "**/*.yml": [
      "npx yaml-lint --ignore=**/node_modules"
    ],
    "**/*": [
      "cspell lint --gitignore --no-must-find-files --unique --no-progress --show-suggestions --color"
    ]
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/storage-file-share": "12.33.0",
    "@microsoft/microsoft-graph-client": "3.1.0",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/cache-manager": "^12.0.5",
    "@nestjs/common": "^12.6.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/swagger": "^12.1.2",
    "axios": "1.21.1",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-basic-auth": "1.2.1",
    "globals": "17.14.0",
    "jest-when": "4.0.3",
    "lodash": "4.18.1",
    "nestjs-pino": "5.3.2",
    "passport": "0.7.0",
    "passport-headerapikey": "1.2.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.9.1",
    "yaml-lint": "1.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.1",
    "@tsconfig/node21": "21.0.10",
    "@types/chance": "1.1.8",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jest-when": "3.5.5",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@ukef/eslint-local-rules": "1.0.0",
    "chance": "1.1.13",
    "cspell": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jest": "29.17.1",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.2",
    "markdownlint-cli": "0.50.1",
    "nock": "^15.0.6",
    "prettier": "3.10.1",
    "sort-package-json": "4.1.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.3.0"
  }
}
